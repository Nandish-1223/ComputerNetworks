#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
#include <termios.h>
#include <arpa/inet.h>

#define PORT 5556
#define BUFFER_SIZE 1024

/* Restore terminal settings before exit */
struct termios orig_tio;
void restore_terminal(void) {
    tcsetattr(STDIN_FILENO, TCSANOW, &orig_tio);
}

int main(int argc, char *argv[]) {
    int sock;
    struct sockaddr_in serv_addr;
    char buffer[BUFFER_SIZE];

    if (argc != 2) {
        fprintf(stderr, "Usage: %s <server_ip>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    /* 1. Create TCP socket */
    if ((sock = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        perror("socket failed");
        exit(EXIT_FAILURE);
    }

    /* 2. Configure server address */
    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);

    if (inet_pton(AF_INET, argv[1], &serv_addr.sin_addr) <= 0) {
        perror("Invalid IP");
        exit(EXIT_FAILURE);
    }

    /* 3. Connect to the remote server */
    if (connect(sock, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        perror("connect failed");
        close(sock);
        exit(EXIT_FAILURE);
    }

    printf("Connected to %s:%d\n", argv[1], PORT);

    /* Fork so we can read from server and keyboard at the same time */
    pid_t pid = fork();
    if (pid < 0) {
        perror("fork failed");
        exit(EXIT_FAILURE);
    }

    if (pid == 0) {
        /* Child: receive messages from server and print them */
        int n;
        while ((n = recv(sock, buffer, BUFFER_SIZE - 1, 0)) > 0) {
            buffer[n] = '\0';
            printf("%s", buffer);
            fflush(stdout);
        }
        if (n == 0) {
            printf("\nServer closed connection\n");
        } else {
            perror("recv failed");
        }
        kill(getppid(), SIGTERM);
        exit(0);
    } else {
        /* Parent: read from keyboard and send to server */

        /* --- Username (normal echo) --- */
        if (fgets(buffer, BUFFER_SIZE, stdin) == NULL) {
            printf("Disconnecting...\n");
            kill(pid, SIGTERM);
            close(sock);
            return 0;
        }
        if (send(sock, buffer, strlen(buffer), 0) < 0) {
            perror("send failed");
            kill(pid, SIGTERM);
            close(sock);
            return 0;
        }

        /* --- Password (hide typing) --- */
        tcgetattr(STDIN_FILENO, &orig_tio);
        struct termios new_tio = orig_tio;
        new_tio.c_lflag &= ~ECHO;               /* disable echo */
        tcsetattr(STDIN_FILENO, TCSANOW, &new_tio);

        if (fgets(buffer, BUFFER_SIZE, stdin) == NULL) {
            restore_terminal();
            printf("\nDisconnecting...\n");
            kill(pid, SIGTERM);
            close(sock);
            return 0;
        }

        restore_terminal();
        printf("\n");                            /* move to next line after hidden input */
        fflush(stdout);

        if (send(sock, buffer, strlen(buffer), 0) < 0) {
            perror("send failed");
            kill(pid, SIGTERM);
            close(sock);
            return 0;
        }

        /* --- General loop for menu and all other inputs --- */
        while (fgets(buffer, BUFFER_SIZE, stdin) != NULL) {
            if (send(sock, buffer, strlen(buffer), 0) < 0) {
                perror("send failed");
                break;
            }
        }
        printf("Disconnecting...\n");
        kill(pid, SIGTERM);
    }

    close(sock);
    return 0;
}
